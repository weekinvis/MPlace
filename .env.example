# Copie este arquivo para ".env" antes de rodar o projeto.
# "cp .env.example .env"

# Porta em que o servidor Express vai rodar
PORT=3000

# Caminho do arquivo do banco SQLite (relativo à raiz do projeto)
DB_STORAGE=./database/marketplace.sqlite

# Segredo usado para assinar o cookie de sessão. Troque por qualquer string longa e aleatória.
SESSION_SECRET=bazari_segredo_super_secreto_troque_em_producao

# Ambiente de execução
NODE_ENV=development
