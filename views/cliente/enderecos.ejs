<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<%- include('../partials/flash') %>

<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 fw-bold mb-0"><i class="bi bi-geo-alt"></i> Meus endereços</h1>
    <button class="btn btn-bazari-primary" type="button" id="btn-novo-endereco">
      <i class="bi bi-plus-lg me-1"></i> Novo endereço
    </button>
  </div>

  <% if (retorno === 'checkout') { %>
    <div class="alert alert-info">Cadastre um endereço para continuar sua compra.</div>
  <% } %>

  <% if (enderecos.length === 0) { %>
    <div class="text-center py-5 text-muted">
      <i class="bi bi-geo display-4"></i>
      <p class="mt-3">Você ainda não tem endereços cadastrados.</p>
    </div>
  <% } %>

  <div class="row g-3">
    <% enderecos.forEach(function(end) { %>
      <div class="col-md-6">
        <div class="card h-100">
          <div class="card-body">
            <div class="d-flex justify-content-between">
              <h2 class="h6 fw-bold">
                <%= end.apelido %>
                <% if (end.principal) { %><span class="badge bg-bazari-primary ms-1">Principal</span><% } %>
              </h2>
            </div>
            <p class="small text-muted mb-3">
              <%= end.logradouro %>, <%= end.numero %><% if (end.complemento) { %> - <%= end.complemento %><% } %><br>
              <%= end.bairro %> - <%= end.cidade %>/<%= end.estado %><br>
              CEP: <%= end.cep %>
            </p>
            <div class="d-flex gap-2">
              <button
                type="button"
                class="btn btn-sm btn-outline-secondary js-editar-endereco"
                data-id="<%= end.id %>"
                data-apelido="<%= end.apelido %>"
                data-cep="<%= end.cep %>"
                data-logradouro="<%= end.logradouro %>"
                data-numero="<%= end.numero %>"
                data-complemento="<%= end.complemento || '' %>"
                data-bairro="<%= end.bairro %>"
                data-cidade="<%= end.cidade %>"
                data-estado="<%= end.estado %>"
                data-principal="<%= end.principal %>"
              >
                <i class="bi bi-pencil"></i> Editar
              </button>

              <form action="/enderecos/<%= end.id %>" method="POST" class="d-inline">
                <input type="hidden" name="_method" value="DELETE">
                <button type="button" class="btn btn-sm btn-outline-danger js-confirmar-exclusao" data-mensagem='Excluir o endereço "<%= end.apelido %>"?'>
                  <i class="bi bi-trash"></i>
                </button>
              </form>
            </div>
          </div>
        </div>
      </div>
    <% }); %>
  </div>
</div>

<!-- Modal criar/editar endereço -->
<div class="modal fade" id="modalEndereco" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <form id="form-endereco" action="/enderecos" method="POST">
        <input type="hidden" name="_method" id="endereco-metodo" value="POST">
        <input type="hidden" name="retorno" value="<%= retorno %>">
        <div class="modal-header">
          <h5 class="modal-title" id="tituloModalEndereco">Novo endereço</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="mb-2">
            <label class="form-label small">Apelido (ex: Casa, Trabalho)</label>
            <input type="text" name="apelido" id="endereco-apelido" class="form-control" required>
          </div>
          <div class="row">
            <div class="col-5 mb-2">
              <label class="form-label small">CEP</label>
              <input type="text" name="cep" id="endereco-cep" class="form-control" required>
            </div>
            <div class="col-7 mb-2">
              <label class="form-label small">Cidade</label>
              <input type="text" name="cidade" id="endereco-cidade" class="form-control" required>
            </div>
          </div>
          <div class="mb-2">
            <label class="form-label small">Logradouro</label>
            <input type="text" name="logradouro" id="endereco-logradouro" class="form-control" required>
          </div>
          <div class="row">
            <div class="col-4 mb-2">
              <label class="form-label small">Número</label>
              <input type="text" name="numero" id="endereco-numero" class="form-control" required>
            </div>
            <div class="col-8 mb-2">
              <label class="form-label small">Complemento</label>
              <input type="text" name="complemento" id="endereco-complemento" class="form-control">
            </div>
          </div>
          <div class="row">
            <div class="col-8 mb-2">
              <label class="form-label small">Bairro</label>
              <input type="text" name="bairro" id="endereco-bairro" class="form-control" required>
            </div>
            <div class="col-4 mb-2">
              <label class="form-label small">UF</label>
              <input type="text" name="estado" id="endereco-estado" maxlength="2" class="form-control text-uppercase" required>
            </div>
          </div>
          <div class="form-check mt-2">
            <input class="form-check-input" type="checkbox" name="principal" id="endereco-principal">
            <label class="form-check-label small" for="endereco-principal">Definir como endereço principal</label>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button type="submit" class="btn btn-bazari-primary">Salvar endereço</button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('../partials/modal-confirmacao') %>

<%- include('../partials/footer') %>
<%- include('../partials/scripts') %>
<script src="/js/enderecos.js"></script>
</body>
</html>
