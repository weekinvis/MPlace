<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<%- include('../partials/flash') %>

<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 fw-bold mb-0"><i class="bi bi-bell"></i> Notificações</h1>
    <button type="button" class="btn btn-sm btn-outline-secondary" id="btn-marcar-todas-lidas">
      Marcar todas como lidas
    </button>
  </div>

  <% if (notificacoes.length === 0) { %>
    <div class="text-center py-5 text-muted">
      <i class="bi bi-bell-slash display-4"></i>
      <p class="mt-3">Você ainda não tem notificações.</p>
    </div>
  <% } %>

  <div class="list-group" id="lista-notificacoes">
    <% notificacoes.forEach(function(n) { %>
      <div class="list-group-item list-group-item-action <%= n.lida ? '' : 'notificacao-nao-lida' %> item-notificacao" data-id="<%= n.id %>">
        <div class="d-flex justify-content-between align-items-start">
          <div>
            <strong class="d-block"><%= n.titulo %></strong>
            <span class="small"><%= n.mensagem %></span><br>
            <span class="small text-muted"><%= new Date(n.createdAt).toLocaleString('pt-BR') %></span>
          </div>
          <div class="d-flex flex-column align-items-end gap-1">
            <% if (n.link) { %><a href="<%= n.link %>" class="small">Ver</a><% } %>
            <% if (!n.lida) { %>
              <button type="button" class="btn btn-sm btn-link p-0 small js-marcar-lida" data-id="<%= n.id %>">Marcar como lida</button>
            <% } %>
          </div>
        </div>
      </div>
    <% }); %>
  </div>
</div>

<%- include('../partials/footer') %>
<%- include('../partials/scripts') %>
</body>
</html>
