<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<%- include('../partials/flash') %>

<%
  function corBadgeEstado(estado) {
    const mapa = { aguardando_confirmacao: 'secondary', confirmado: 'info', em_preparacao: 'warning', enviado: 'primary', entregue: 'success', cancelado: 'danger' };
    return mapa[estado] || 'secondary';
  }
  const podeCancelar = ['aguardando_confirmacao', 'confirmado'].includes(pedido.estado);
%>

<div class="container py-4" id="pagina-pedido" data-pedido-id="<%= pedido.id %>">
  <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
      <h1 class="h4 fw-bold mb-1">Pedido <%= pedido.numeroPedido %></h1>
      <span class="text-muted small">Realizado em <%= new Date(pedido.createdAt).toLocaleDateString('pt-BR') %></span>
    </div>
    <span class="badge bg-<%= corBadgeEstado(pedido.estado) %> fs-6 px-3 py-2" id="badge-estado-pedido"><%= ROTULOS_ESTADO[pedido.estado] %></span>
  </div>

  <div class="row g-4">
    <div class="col-lg-8">
      <div class="card mb-3">
        <div class="card-header bg-white fw-semibold small">
          <i class="bi bi-shop"></i>
          <% if (pedido.itens[0] && pedido.itens[0].vendedor && pedido.itens[0].vendedor.perfilVendedor) { %>
            <%= pedido.itens[0].vendedor.perfilVendedor.nomeLoja %>
          <% } %>
        </div>
        <div class="card-body p-0">
          <% pedido.itens.forEach(function(item) { %>
            <div class="row g-0 align-items-center p-3 border-bottom">
              <div class="col-2 col-md-1">
                <img src="<%= item.imagemProduto || '/images/produtos/default.svg' %>" class="img-fluid rounded" alt="">
              </div>
              <div class="col-7 col-md-8 ps-3 small">
                <%= item.nomeProduto %>
                <div class="text-muted">Qtd: <%= item.quantidade %> × R$ <%= Number(item.precoUnitario).toFixed(2).replace('.', ',') %></div>
              </div>
              <div class="col-3 text-end fw-semibold small">R$ <%= Number(item.subtotal).toFixed(2).replace('.', ',') %></div>
            </div>
          <% }); %>
        </div>
      </div>

      <!-- Timeline -->
      <div class="card">
        <div class="card-body">
          <h2 class="h6 fw-bold mb-3">Histórico do pedido</h2>
          <ul class="timeline-pedido list-unstyled" id="timeline-pedido">
            <% pedido.historico.forEach(function(h) { %>
              <li>
                <strong><%= ROTULOS_ESTADO[h.estadoNovo] || h.estadoNovo %></strong>
                <span class="text-muted small d-block"><%= new Date(h.createdAt).toLocaleString('pt-BR') %></span>
              </li>
            <% }); %>
          </ul>
        </div>
      </div>
    </div>

    <div class="col-lg-4">
      <div class="card mb-3">
        <div class="card-body">
          <h2 class="h6 fw-bold mb-2"><i class="bi bi-geo-alt"></i> Endereço de entrega</h2>
          <p class="small text-muted mb-0">
            <%= pedido.endereco.logradouro %>, <%= pedido.endereco.numero %><br>
            <%= pedido.endereco.bairro %> - <%= pedido.endereco.cidade %>/<%= pedido.endereco.estado %><br>
            CEP: <%= pedido.endereco.cep %>
          </p>
        </div>
      </div>

      <div class="card">
        <div class="card-body">
          <h2 class="h6 fw-bold mb-2">Resumo</h2>
          <div class="d-flex justify-content-between small"><span>Produtos</span><span>R$ <%= Number(pedido.valorProdutos).toFixed(2).replace('.', ',') %></span></div>
          <div class="d-flex justify-content-between small"><span>Frete</span><span><%= Number(pedido.valorFrete) === 0 ? 'Grátis' : 'R$ ' + Number(pedido.valorFrete).toFixed(2).replace('.', ',') %></span></div>
          <hr>
          <div class="d-flex justify-content-between fw-bold"><span>Total</span><span>R$ <%= Number(pedido.valorTotal).toFixed(2).replace('.', ',') %></span></div>
          <p class="small text-muted mt-2 mb-0">Pagamento: <%= { cartao: 'Cartão', pix: 'Pix', boleto: 'Boleto' }[pedido.formaPagamento] %></p>

          <% if (podeCancelar) { %>
            <form action="/pedidos/<%= pedido.id %>/cancelar" method="POST" class="mt-3">
              <input type="hidden" name="_method" value="PATCH">
              <button type="button" class="btn btn-outline-danger btn-sm w-100 js-confirmar-exclusao" data-mensagem="Tem certeza que deseja cancelar este pedido?">
                <i class="bi bi-x-circle"></i> Cancelar pedido
              </button>
            </form>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/modal-confirmacao') %>

<%- include('../partials/footer') %>
<%- include('../partials/scripts') %>
</body>
</html>
