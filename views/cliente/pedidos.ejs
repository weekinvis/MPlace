<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<%- include('../partials/flash') %>

<%
  function corBadgeEstado(estado) {
    const mapa = {
      aguardando_confirmacao: 'secondary',
      confirmado: 'info',
      em_preparacao: 'warning',
      enviado: 'primary',
      entregue: 'success',
      cancelado: 'danger',
    };
    return mapa[estado] || 'secondary';
  }
%>

<div class="container py-4">
  <h1 class="h3 fw-bold mb-4"><i class="bi bi-box-seam"></i> Meus pedidos</h1>

  <% if (pedidos.length === 0) { %>
    <div class="text-center py-5 text-muted">
      <i class="bi bi-bag-x display-4"></i>
      <p class="mt-3">Você ainda não fez nenhum pedido.</p>
      <a href="/produtos" class="btn btn-bazari-primary">Ver catálogo</a>
    </div>
  <% } %>

  <% pedidos.forEach(function(pedido) { %>
    <div class="card mb-3">
      <div class="card-body">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
          <div>
            <strong>Pedido <%= pedido.numeroPedido %></strong>
            <div class="small text-muted">
              <%= new Date(pedido.createdAt).toLocaleDateString('pt-BR') %> ·
              <%= pedido.itens.length %> item(ns) ·
              R$ <%= Number(pedido.valorTotal).toFixed(2).replace('.', ',') %>
            </div>
          </div>
          <div class="d-flex align-items-center gap-2">
            <span class="badge bg-<%= corBadgeEstado(pedido.estado) %>"><%= ROTULOS_ESTADO[pedido.estado] %></span>
            <a href="/pedidos/<%= pedido.id %>" class="btn btn-sm btn-outline-secondary">Ver detalhes</a>
          </div>
        </div>
      </div>
    </div>
  <% }); %>
</div>

<%- include('../partials/footer') %>
<%- include('../partials/scripts') %>
</body>
</html>
