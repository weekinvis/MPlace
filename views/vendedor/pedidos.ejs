<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<%- include('../partials/flash') %>

<%
  function corBadgeEstado(estado) {
    const mapa = { aguardando_confirmacao: 'secondary', confirmado: 'info', em_preparacao: 'warning', enviado: 'primary', entregue: 'success', cancelado: 'danger' };
    return mapa[estado] || 'secondary';
  }
%>

<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <h1 class="h3 fw-bold mb-0"><i class="bi bi-receipt"></i> Pedidos recebidos</h1>
    <form method="GET" class="d-flex align-items-center gap-2">
      <label class="small text-muted mb-0">Filtrar:</label>
      <select name="estado" class="form-select form-select-sm" onchange="this.form.submit()">
        <option value="">Todos os status</option>
        <% Object.keys(ROTULOS_ESTADO).forEach(function(chave) { %>
          <option value="<%= chave %>" <%= filtroEstado === chave ? 'selected' : '' %>><%= ROTULOS_ESTADO[chave] %></option>
        <% }); %>
      </select>
    </form>
  </div>

  <% if (pedidos.length === 0) { %>
    <div class="text-center py-5 text-muted">
      <i class="bi bi-inbox display-4"></i>
      <p class="mt-3">Nenhum pedido encontrado.</p>
    </div>
  <% } %>

  <% pedidos.forEach(function(pedido) { %>
    <div class="card mb-3">
      <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div>
          <strong><%= pedido.numeroPedido %></strong>
          <div class="small text-muted">
            Cliente: <%= pedido.cliente.nome %> ·
            <%= new Date(pedido.createdAt).toLocaleDateString('pt-BR') %> ·
            <%= pedido.itens.length %> item(ns)
          </div>
        </div>
        <div class="d-flex align-items-center gap-2">
          <span class="badge bg-<%= corBadgeEstado(pedido.estado) %>"><%= ROTULOS_ESTADO[pedido.estado] %></span>
          <a href="/vendedor/pedidos/<%= pedido.id %>" class="btn btn-sm btn-outline-secondary">Gerenciar</a>
        </div>
      </div>
    </div>
  <% }); %>
</div>

<%- include('../partials/footer') %>
<%- include('../partials/scripts') %>
</body>
</html>
