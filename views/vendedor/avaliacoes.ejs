<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<%- include('../partials/flash') %>

<%
  function corBadgeModeracao(estado) {
    const mapa = { pendente: 'warning', aprovada: 'success', oculta: 'secondary' };
    return mapa[estado] || 'secondary';
  }
%>

<div class="container py-4">
  <h1 class="h3 fw-bold mb-4"><i class="bi bi-star"></i> Avaliações recebidas</h1>

  <% if (avaliacoes.length === 0) { %>
    <div class="text-center py-5 text-muted">
      <i class="bi bi-chat-square-text display-4"></i>
      <p class="mt-3">Seus produtos ainda não receberam avaliações.</p>
    </div>
  <% } %>

  <% avaliacoes.forEach(function(a) { %>
    <div class="card mb-3">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-start">
          <div class="d-flex align-items-center gap-2">
            <img src="<%= a.cliente.avatar || '/images/avatars/default.svg' %>" class="avatar-navbar" alt="">
            <div>
              <strong class="small d-block"><%= a.cliente.nome %></strong>
              <span class="small text-muted">sobre <a href="/produtos/<%= a.produto.id %>"><%= a.produto.nome %></a></span>
            </div>
          </div>
          <span class="badge bg-<%= corBadgeModeracao(a.estadoModeracao) %>"><%= a.estadoModeracao %></span>
        </div>
        <div class="my-2"><%- include('../partials/estrelas', { nota: a.nota }) %></div>
        <p class="mb-0 small"><%= a.comentario %></p>
      </div>
    </div>
  <% }); %>
</div>

<%- include('../partials/footer') %>
<%- include('../partials/scripts') %>
</body>
</html>
