<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<%- include('../partials/flash') %>

<%
  const editando = produto && produto.id;
  const acaoForm = editando ? `/vendedor/produtos/${produto.id}` : '/vendedor/produtos/novo';
%>

<div class="container py-4">
  <h1 class="h3 fw-bold mb-4">
    <i class="bi bi-box-seam"></i> <%= editando ? 'Editar produto' : 'Novo produto' %>
  </h1>

  <% if (erros && erros.length > 0) { %>
    <div class="alert alert-danger">
      <ul class="mb-0 ps-3"><% erros.forEach(function(erro) { %><li><%= erro %></li><% }); %></ul>
    </div>
  <% } %>

  <form action="<%= acaoForm %>" method="POST" enctype="multipart/form-data">
    <% if (editando) { %><input type="hidden" name="_method" value="PUT"><% } %>

    <div class="row g-4">
      <div class="col-lg-4">
        <label class="form-label small fw-semibold">Imagem do produto</label>
        <div class="preview-imagem-produto mb-2">
          <img id="preview-imagem" src="<%= (produto && produto.imagem) ? produto.imagem : '/images/produtos/default.svg' %>" alt="Pré-visualização" class="img-fluid rounded-4">
        </div>
        <input type="file" name="imagem" id="input-imagem" accept="image/*" class="form-control form-control-sm js-preview-imagem" data-preview-target="#preview-imagem">
        <div class="form-text">PNG, JPG ou WEBP até 5MB. Deixe em branco para manter a imagem atual.</div>
      </div>

      <div class="col-lg-8">
        <div class="mb-3">
          <label class="form-label small fw-semibold">Nome do produto</label>
          <input type="text" name="nome" class="form-control" required value="<%= (produto && produto.nome) || '' %>">
        </div>

        <div class="mb-3">
          <label class="form-label small fw-semibold">Descrição</label>
          <textarea name="descricao" class="form-control" rows="4" required><%= (produto && produto.descricao) || '' %></textarea>
        </div>

        <div class="row">
          <div class="col-md-4 mb-3">
            <label class="form-label small fw-semibold">Preço (R$)</label>
            <input type="number" step="0.01" min="0.01" name="preco" class="form-control" required value="<%= (produto && produto.preco) || '' %>">
          </div>
          <div class="col-md-4 mb-3">
            <label class="form-label small fw-semibold">Preço promocional (opcional)</label>
            <input type="number" step="0.01" min="0" name="precoPromocional" class="form-control" value="<%= (produto && produto.precoPromocional) || '' %>">
          </div>
          <div class="col-md-4 mb-3">
            <label class="form-label small fw-semibold">Estoque</label>
            <input type="number" min="0" name="estoque" class="form-control" required value="<%= (produto && produto.estoque !== undefined) ? produto.estoque : 0 %>">
          </div>
        </div>

        <div class="row">
          <div class="col-md-6 mb-3">
            <label class="form-label small fw-semibold">Categoria</label>
            <select name="categoriaId" class="form-select" required>
              <option value="">Selecione...</option>
              <% categorias.forEach(function(cat) { %>
                <option value="<%= cat.id %>" <%= produto && String(produto.categoriaId) === String(cat.id) ? 'selected' : '' %>>
                  <%= cat.nome %>
                </option>
              <% }); %>
            </select>
          </div>
          <div class="col-md-3 mb-3">
            <label class="form-label small fw-semibold">Marca</label>
            <input type="text" name="marca" class="form-control" value="<%= (produto && produto.marca) || '' %>">
          </div>
          <div class="col-md-3 mb-3">
            <label class="form-label small fw-semibold">Cor</label>
            <input type="text" name="cor" class="form-control" value="<%= (produto && produto.cor) || '' %>">
          </div>
        </div>

        <div class="form-check mb-3">
          <input class="form-check-input" type="checkbox" name="destaque" id="destaque" <%= (produto && produto.destaque) ? 'checked' : '' %>>
          <label class="form-check-label small" for="destaque">Exibir como produto em destaque na página inicial</label>
        </div>

        <button type="submit" class="btn btn-bazari-primary px-4">
          <%= editando ? 'Salvar alterações' : 'Cadastrar produto' %>
        </button>
        <a href="/vendedor/produtos" class="btn btn-link">Cancelar</a>
      </div>
    </div>
  </form>
</div>

<%- include('../partials/footer') %>
<%- include('../partials/scripts') %>
<script src="/js/produto-form.js"></script>
</body>
</html>
