<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<%- include('../partials/flash') %>

<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 fw-bold mb-0"><i class="bi bi-box-seam"></i> Meus produtos</h1>
    <a href="/vendedor/produtos/novo" class="btn btn-bazari-primary"><i class="bi bi-plus-lg me-1"></i> Novo produto</a>
  </div>

  <% if (produtos.length === 0) { %>
    <div class="text-center py-5 text-muted">
      <i class="bi bi-box display-4"></i>
      <p class="mt-3">Você ainda não cadastrou nenhum produto.</p>
      <a href="/vendedor/produtos/novo" class="btn btn-bazari-primary">Cadastrar primeiro produto</a>
    </div>
  <% } else { %>
    <div class="table-responsive">
      <table class="table align-middle bg-white">
        <thead>
          <tr class="small text-muted">
            <th>Produto</th>
            <th>Categoria</th>
            <th>Preço</th>
            <th>Estoque</th>
            <th>Status</th>
            <th class="text-end">Ações</th>
          </tr>
        </thead>
        <tbody>
          <% produtos.forEach(function(produto) { %>
            <tr data-produto-id="<%= produto.id %>">
              <td>
                <div class="d-flex align-items-center gap-2">
                  <img src="<%= produto.imagem %>" class="produto-thumb" alt="">
                  <span class="small fw-semibold"><%= produto.nome %></span>
                </div>
              </td>
              <td class="small"><%= produto.categoria.nome %></td>
              <td class="small">R$ <%= Number(produto.preco).toFixed(2).replace('.', ',') %></td>
              <td style="width: 110px;">
                <input type="number" min="0" class="form-control form-control-sm js-input-estoque" data-produto-id="<%= produto.id %>" value="<%= produto.estoque %>">
              </td>
              <td>
                <% if (produto.estado === 'bloqueado') { %>
                  <span class="badge bg-danger" title="Bloqueado pelo administrador">Bloqueado</span>
                <% } else { %>
                  <div class="form-check form-switch">
                    <input class="form-check-input js-toggle-status" type="checkbox" role="switch" data-produto-id="<%= produto.id %>" <%= produto.estado === 'ativo' ? 'checked' : '' %>>
                    <label class="form-check-label small js-status-label"><%= produto.estado === 'ativo' ? 'Ativo' : 'Inativo' %></label>
                  </div>
                <% } %>
              </td>
              <td class="text-end">
                <a href="/vendedor/produtos/<%= produto.id %>/editar" class="btn btn-sm btn-outline-secondary" title="Editar">
                  <i class="bi bi-pencil"></i>
                </a>
                <form action="/vendedor/produtos/<%= produto.id %>" method="POST" class="d-inline">
                  <input type="hidden" name="_method" value="DELETE">
                  <button type="button" class="btn btn-sm btn-outline-danger js-confirmar-exclusao" data-mensagem='Excluir o produto "<%= produto.nome %>"?' title="Excluir">
                    <i class="bi bi-trash"></i>
                  </button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<%- include('../partials/modal-confirmacao') %>

<%- include('../partials/footer') %>
<%- include('../partials/scripts') %>
<script src="/js/vendedor-produtos.js"></script>
</body>
</html>
