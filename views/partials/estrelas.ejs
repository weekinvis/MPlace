<%
// Partial de exibição de estrelas. Espera receber `nota` (0-5, pode ser decimal).
const notaSegura = typeof nota === 'number' ? nota : 0;
const estrelasCheias = Math.round(notaSegura);
%>
<span class="estrelas" aria-label="Nota <%= notaSegura %> de 5">
  <% for (let i = 1; i <= 5; i++) { %>
    <i class="bi <%= i <= estrelasCheias ? 'bi-star-fill' : 'bi-star' %>"></i>
  <% } %>
</span>
