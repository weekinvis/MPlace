<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<%- include('../partials/flash') %>

<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <h1 class="h3 fw-bold mb-0"><i class="bi bi-star"></i> Moderação de avaliações</h1>
    <form method="GET" class="d-flex align-items-center gap-2">
      <select name="estado" class="form-select form-select-sm" onchange="this.form.submit()">
        <option value="">Todos os status</option>
        <option value="pendente" <%= filtroEstado === 'pendente' ? 'selected' : '' %>>Pendente</option>
        <option value="aprovada" <%= filtroEstado === 'aprovada' ? 'selected' : '' %>>Aprovada</option>
        <option value="oculta" <%= filtroEstado === 'oculta' ? 'selected' : '' %>>Oculta</option>
      </select>
    </form>
  </div>

  <% if (avaliacoes.length === 0) { %>
    <div class="text-center py-5 text-muted">
      <i class="bi bi-check2-circle display-4"></i>
      <p class="mt-3">Nenhuma avaliação encontrada com esse filtro.</p>
    </div>
  <% } %>

  <% avaliacoes.forEach(function(a) { %>
    <div class="card mb-3" data-avaliacao-id="<%= a.id %>">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
          <div>
            <strong class="small d-block"><%= a.cliente.nome %></strong>
            <span class="small text-muted">sobre <a href="/produtos/<%= a.produto.id %>"><%= a.produto.nome %></a></span>
          </div>
          <span class="badge js-badge-moderacao bg-<%= a.estadoModeracao === 'aprovada' ? 'success' : (a.estadoModeracao === 'pendente' ? 'warning' : 'secondary') %>">
            <%= a.estadoModeracao %>
          </span>
        </div>
        <div class="my-2"><%- include('../partials/estrelas', { nota: a.nota }) %></div>
        <p class="small"><%= a.comentario %></p>

        <div class="d-flex gap-2">
          <% if (a.estadoModeracao !== 'aprovada') { %>
            <button type="button" class="btn btn-sm btn-outline-success js-moderar-avaliacao" data-id="<%= a.id %>" data-acao="aprovar">
              <i class="bi bi-check-lg"></i> Aprovar
            </button>
          <% } %>
          <% if (a.estadoModeracao !== 'oculta') { %>
            <button type="button" class="btn btn-sm btn-outline-secondary js-moderar-avaliacao" data-id="<%= a.id %>" data-acao="ocultar">
              <i class="bi bi-eye-slash"></i> Ocultar
            </button>
          <% } %>
        </div>
      </div>
    </div>
  <% }); %>
</div>

<%- include('../partials/footer') %>
<%- include('../partials/scripts') %>
<script src="/js/admin.js"></script>
</body>
</html>
