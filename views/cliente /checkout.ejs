<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<%- include('../partials/flash') %>

<div class="container py-4">
  <h1 class="h3 fw-bold mb-4"><i class="bi bi-bag-check"></i> Finalizar compra</h1>

  <form action="/checkout" method="POST" id="form-checkout">
    <div class="row">
      <div class="col-lg-8">

        <!-- Endereço -->
        <div class="card mb-3">
          <div class="card-body">
            <h2 class="h6 fw-bold mb-3"><i class="bi bi-geo-alt"></i> Endereço de entrega</h2>
            <% enderecos.forEach(function(end, i) { %>
              <div class="form-check border rounded p-3 mb-2">
                <input class="form-check-input" type="radio" name="enderecoId" id="end-<%= end.id %>" value="<%= end.id %>" <%= i === 0 ? 'checked' : '' %> required>
                <label class="form-check-label w-100" for="end-<%= end.id %>">
                  <strong><%= end.apelido %></strong><% if (end.principal) { %> <span class="badge bg-bazari-primary">Principal</span><% } %><br>
                  <span class="small text-muted"><%= end.logradouro %>, <%= end.numero %> - <%= end.bairro %>, <%= end.cidade %>/<%= end.estado %></span>
                </label>
              </div>
            <% }); %>
            <a href="/enderecos" class="small">+ Adicionar novo endereço</a>
          </div>
        </div>

        <!-- Pagamento -->
        <div class="card mb-3">
          <div class="card-body">
            <h2 class="h6 fw-bold mb-3"><i class="bi bi-credit-card"></i> Forma de pagamento</h2>
            <div class="btn-group w-100" role="group">
              <input type="radio" class="btn-check" name="formaPagamento" id="pag-cartao" value="cartao" checked>
              <label class="btn btn-outline-secondary" for="pag-cartao"><i class="bi bi-credit-card-2-front"></i> Cartão</label>

              <input type="radio" class="btn-check" name="formaPagamento" id="pag-pix" value="pix">
              <label class="btn btn-outline-secondary" for="pag-pix"><i class="bi bi-qr-code"></i> Pix</label>

              <input type="radio" class="btn-check" name="formaPagamento" id="pag-boleto" value="boleto">
              <label class="btn btn-outline-secondary" for="pag-boleto"><i class="bi bi-upc-scan"></i> Boleto</label>
            </div>
            <div class="form-text">Simulação: nenhum dado de pagamento real é processado neste projeto acadêmico.</div>
          </div>
        </div>

        <!-- Entrega -->
        <div class="card mb-3">
          <div class="card-body">
            <h2 class="h6 fw-bold mb-3"><i class="bi bi-truck"></i> Forma de entrega</h2>
            <div class="form-check">
              <input class="form-check-input js-forma-entrega" type="radio" name="formaEntrega" id="ent-padrao" value="padrao" checked>
              <label class="form-check-label" for="ent-padrao">Padrão (5-8 dias úteis) — R$ 15,00 (grátis acima de R$ 200 por loja)</label>
            </div>
            <div class="form-check">
              <input class="form-check-input js-forma-entrega" type="radio" name="formaEntrega" id="ent-expressa" value="expressa">
              <label class="form-check-label" for="ent-expressa">Expressa (1-3 dias úteis) — R$ 35,00 (grátis acima de R$ 200 por loja)</label>
            </div>
          </div>
        </div>
      </div>

      <div class="col-lg-4">
        <div class="card">
          <div class="card-body">
            <h2 class="h6 fw-bold mb-3">Resumo do pedido</h2>
            <p class="small text-muted">Sua compra será dividida em <%= gruposPorVendedor.length %> pedido(s), um para cada loja.</p>

            <% gruposPorVendedor.forEach(function(grupo, i) { %>
              <div class="border-bottom pb-2 mb-2 grupo-resumo" data-subtotal="<%= grupo.subtotal %>">
                <div class="d-flex justify-content-between small fw-semibold">
                  <span><i class="bi bi-shop"></i> <%= grupo.vendedor.perfilVendedor.nomeLoja %></span>
                  <span>R$ <%= grupo.subtotal.toFixed(2).replace('.', ',') %></span>
                </div>
                <div class="d-flex justify-content-between small text-muted">
                  <span>Frete</span>
                  <span class="js-frete-grupo">R$ <%= (grupo.subtotal >= 200 ? 0 : 15).toFixed(2).replace('.', ',') %></span>
                </div>
              </div>
            <% }); %>

            <div class="d-flex justify-content-between mt-3">
              <strong>Total estimado</strong>
              <strong id="total-geral">R$ <%= Number(subtotalGeral).toFixed(2).replace('.', ',') %></strong>
            </div>

            <button type="submit" class="btn btn-bazari-primary w-100 py-2 mt-3">
              Confirmar pedido <i class="bi bi-check2-circle"></i>
            </button>
          </div>
        </div>
      </div>
    </div>
  </form>
</div>

<%- include('../partials/footer') %>
<%- include('../partials/scripts') %>
<script src="/js/checkout.js"></script>
</body>
</html>
