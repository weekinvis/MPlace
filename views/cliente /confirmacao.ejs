<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<%- include('../partials/flash') %>

<div class="container py-5">
  <div class="text-center mb-5">
    <i class="bi bi-check-circle-fill text-success display-1"></i>
    <h1 class="h3 fw-bold mt-3">Pedido confirmado!</h1>
    <p class="text-muted">
      Sua compra foi dividida em <%= pedidos.length %> pedido<%= pedidos.length > 1 ? 's' : '' %>
      (um para cada loja envolvida). Acompanhe o status de cada um separadamente.
    </p>
  </div>

  <div class="row justify-content-center">
    <div class="col-lg-8">
      <% pedidos.forEach(function(pedido) { %>
        <div class="card mb-3">
          <div class="card-body d-flex justify-content-between align-items-center">
            <div>
              <strong>Pedido <%= pedido.numeroPedido %></strong>
              <div class="small text-muted"><%= pedido.itens.length %> item(ns) · R$ <%= Number(pedido.valorTotal).toFixed(2).replace('.', ',') %></div>
            </div>
            <a href="/pedidos/<%= pedido.id %>" class="btn btn-sm btn-outline-secondary">Ver detalhes</a>
          </div>
        </div>
      <% }); %>

      <div class="text-center mt-4">
        <a href="/produtos" class="btn btn-bazari-primary">Continuar comprando</a>
        <a href="/pedidos" class="btn btn-link">Ver todos os meus pedidos</a>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
<%- include('../partials/scripts') %>
</body>
</html>
