<%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
      <div class="card card-auth">
        <div class="card-body p-4 p-md-5">
          <h1 class="h3 fw-bold text-center mb-1">Bem-vindo(a) de volta</h1>
          <p class="text-muted text-center mb-4">Entre para continuar no Bazari.</p>

          <% if (erro) { %>
            <div class="alert alert-danger"><%= erro %></div>
          <% } %>

          <form action="/login" method="POST">
            <div class="mb-3">
              <label for="email" class="form-label small fw-semibold">E-mail</label>
              <input type="email" class="form-control" id="email" name="email" required value="<%= emailAntigo || '' %>" autofocus>
            </div>
            <div class="mb-3">
              <label for="senha" class="form-label small fw-semibold">Senha</label>
              <input type="password" class="form-control" id="senha" name="senha" required>
            </div>
            <button type="submit" class="btn btn-bazari-primary w-100 py-2 mt-2">Entrar</button>
          </form>

          <p class="text-center text-muted small mt-4 mb-1">
            Ainda não tem conta? <a href="/cadastro">Criar conta</a>
          </p>

          <div class="alert alert-light border small mt-4 mb-0">
            <strong>Contas de demonstração</strong> (senha entre parênteses):<br>
            Admin: <code>admin@bazari.com</code> (<code>admin123</code>)<br>
            Vendedor: <code>rafael@techpoint.com.br</code> (<code>vendedor123</code>)<br>
            Cliente: <code>ana@email.com</code> (<code>cliente123</code>)
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
<%- include('../partials/scripts') %>
</body>
</html>
