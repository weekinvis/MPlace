<div class="d-flex justify-content-between align-items-center mb-3">
  <span class="text-muted small"><%= total %> produto<%= total === 1 ? '' : 's' %> encontrado<%= total === 1 ? '' : 's' %></span>
</div>

<% if (produtos.length === 0) { %>
  <div class="text-center py-5">
    <i class="bi bi-search display-4 text-muted"></i>
    <p class="mt-3 text-muted">Nenhum produto encontrado com esses filtros.</p>
    <a href="/produtos" class="btn btn-outline-secondary btn-sm">Limpar filtros</a>
  </div>
<% } else { %>
  <div class="row row-cols-2 row-cols-md-3 row-cols-lg-3 g-3">
    <% produtos.forEach(function(produto) { %>
      <%- include('../partials/produto-card', { produto }) %>
    <% }); %>
  </div>

  <div class="mt-4">
    <%- include('../partials/paginacao') %>
  </div>
<% } %>
