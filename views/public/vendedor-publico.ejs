<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<%- include('../partials/flash') %>

<div class="loja-banner" style="background-image: url('<%= vendedor.perfilVendedor.banner %>')"></div>

<div class="container py-4">
  <div class="d-flex align-items-center gap-3 mb-4 loja-cabecalho">
    <img src="<%= vendedor.perfilVendedor.logo %>" alt="<%= vendedor.perfilVendedor.nomeLoja %>" class="loja-logo-grande">
    <div>
      <h1 class="h3 fw-bold mb-1"><%= vendedor.perfilVendedor.nomeLoja %></h1>
      <div class="d-flex align-items-center gap-2">
        <%- include('../partials/estrelas', { nota: mediaNota ? Number(mediaNota) : 0 }) %>
        <span class="small text-muted">
          <% if (mediaNota) { %><%= mediaNota %> (<%= totalAvaliacoes %> avaliações)<% } else { %>Sem avaliações ainda<% } %>
        </span>
      </div>
    </div>
  </div>

  <% if (vendedor.perfilVendedor.descricao) { %>
    <p class="text-body-secondary mb-4"><%= vendedor.perfilVendedor.descricao %></p>
  <% } %>

  <h2 class="h5 fw-bold mb-3"><i class="bi bi-bag"></i> Produtos desta loja (<%= produtos.length %>)</h2>

  <% if (produtos.length === 0) { %>
    <p class="text-muted">Esta loja ainda não tem produtos ativos.</p>
  <% } else { %>
    <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-3">
      <% produtos.forEach(function(produto) { %>
        <%- include('../partials/produto-card', { produto }) %>
      <% }); %>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
<%- include('../partials/scripts') %>
<script src="/js/carrinho.js"></script>
</body>
</html>
